---
/**
 * Required forms.
 *
 * What a person has to complete to work in security in New Jersey, in the
 * order they meet it. Students arrive knowing they need "the forms" and not
 * which ones, who issues them, or which half their employer is supposed to
 * fill in.
 *
 * Every entry links to the issuing agency and nowhere else. The academy hosts
 * no copies: a mirrored PDF goes stale silently while still looking official,
 * and last year's form carrying this year's confidence is worse than no form
 * at all.
 *
 * Each one also shows when a person last checked that link. The academy cannot
 * promise an agency has not moved something this morning, so it shows the date
 * instead and lets the reader judge how fresh the list is.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { getCopy } from '../lib/content/repository';

const { supabase } = Astro.locals;

type Category = { key: string; label: string; description: string | null; sort_order: number };
type FormRow = {
  id: string;
  category_key: string | null;
  name: string;
  form_number: string | null;
  issuing_agency: string;
  description: string | null;
  source_url: string;
  audience: 'student' | 'instructor' | 'employer';
  is_required: boolean;
  notes: string | null;
  last_verified_at: string | null;
  sort_order: number;
};

let categories: Category[] = [];
let forms: FormRow[] = [];

const copy = await getCopy(supabase);

if (supabase) {
  const [cats, rows] = await Promise.all([
    supabase.from('form_categories').select('*').order('sort_order'),
    supabase
      .from('required_forms')
      .select(
        'id, category_key, name, form_number, issuing_agency, description, source_url, audience, is_required, notes, last_verified_at, sort_order',
      )
      .eq('status', 'published')
      .order('sort_order'),
  ]);

  categories = (cats.data ?? []) as unknown as Category[];
  forms = (rows.data ?? []) as unknown as FormRow[];
}

const byCategory = new Map<string, FormRow[]>();
for (const form of forms) {
  const key = form.category_key ?? 'other';
  byCategory.set(key, [...(byCategory.get(key) ?? []), form]);
}

/** Only categories that actually have something published under them. */
const populated = categories.filter((category) => (byCategory.get(category.key) ?? []).length > 0);

const AUDIENCE_LABEL: Record<FormRow['audience'], string> = {
  student: 'You complete this',
  instructor: 'Your instructor completes this',
  employer: 'Your employer completes this',
};

function verified(value: string | null): string | null {
  if (!value) return null;
  return new Date(`${value}T00:00:00`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Required Forms"
  description="The registration, background check, firearms and employer paperwork needed to work in security in New Jersey — each one linked to the agency that issues it."
>
  <PageBanner
    eyebrow="Paperwork"
    heading="Required {{Forms}}"
    intro="Everything you will be asked to complete, who issues it, and where to get it. Every link goes to the agency itself — we do not host copies, because a copy goes out of date without anyone noticing."
  />

  <div class="forms-wrap">
    {
      populated.length === 0 && (
        <div class="forms-empty">
          <h2>This list is still being put together.</h2>
          <p>
            Rather than publish a half-finished list of the paperwork your licence depends on, we
            are leaving it empty until every entry has been checked against the agency that issues
            it. Call us in the meantime and we will walk you through exactly what you need.
          </p>
        </div>
      )
    }

    {
      populated.map((category) => (
        <section class="forms-group">
          <div class="forms-group-head">
            <h2>{category.label}</h2>
            {category.description && <p>{category.description}</p>}
          </div>

          {(byCategory.get(category.key) ?? []).map((form) => (
            <article class:list={['form-card', { optional: !form.is_required }]}>
              <div class="form-card-head">
                <h3>{form.name}</h3>
                {form.form_number && <span class="form-number mono">{form.form_number}</span>}
                {!form.is_required && <span class="form-flag">Not always required</span>}
              </div>

              <p class="form-agency">Issued by {form.issuing_agency}</p>

              {form.description && <p class="form-desc">{form.description}</p>}

              {form.notes && (
                <p class="form-notes">
                  <strong>Before you go:</strong> {form.notes}
                </p>
              )}

              <div class="form-foot">
                <a
                  class="form-link"
                  href={form.source_url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open it on the {form.issuing_agency} site →
                </a>

                <span class="form-meta">
                  {AUDIENCE_LABEL[form.audience]}
                  {verified(form.last_verified_at) && (
                    <> · link checked {verified(form.last_verified_at)}</>
                  )}
                </span>
              </div>
            </article>
          ))}
        </section>
      ))
    }

    <Disclaimer
      headline="Check with the issuing agency before you file."
      body={copy['forms.disclaimer'] ??
        'This page is a guide to where the paperwork lives, not legal advice and not a substitute for the agency’s own instructions. Requirements change, forms are renumbered, and what applies to you depends on the role you are taking. Always read the current instructions on the agency’s own page before submitting anything.'}
    />
  </div>

  <CtaBand
    heading="Not sure which of these apply to you?"
    body="Which forms you need depends on the role you are training for. Ask us and we will tell you exactly what to bring."
  />
</BaseLayout>

<style>
  .forms-wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 90px 20px;
  }

  .forms-empty {
    text-align: center;
    padding: 60px 24px;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius);
    color: var(--text-muted);
  }

  .forms-empty h2 {
    color: var(--text-bright);
    font-size: 1.2rem;
    margin-bottom: 14px;
  }

  .forms-empty p {
    max-width: 62ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  .forms-group {
    margin-bottom: 46px;
  }

  .forms-group-head {
    border-bottom: 2px solid var(--primary);
    padding-bottom: 10px;
    margin-bottom: 18px;
  }

  .forms-group-head h2 {
    font-size: 1.2rem;
    letter-spacing: 2px;
    color: var(--text-bright);
  }

  .forms-group-head p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 6px;
    max-width: 70ch;
  }

  .form-card {
    background: var(--bg-card);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--primary);
    border-radius: 3px;
    padding: 18px 20px;
    margin-bottom: 12px;
  }

  /* Optional paperwork reads quieter, so the required list is what the eye
     lands on first. */
  .form-card.optional {
    border-left-color: var(--hairline);
  }

  .form-card-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .form-card-head h3 {
    font-size: 1rem;
    color: var(--text-bright);
  }

  .form-number {
    font-size: 0.78rem;
    letter-spacing: 1px;
    color: var(--accent);
  }

  .form-flag {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .form-agency {
    color: var(--text-muted);
    font-size: 0.84rem;
    margin-top: 4px;
  }

  .form-desc {
    margin-top: 10px;
    line-height: 1.65;
  }

  .form-notes {
    margin-top: 10px;
    padding: 10px 12px;
    background: var(--bg-card-alt);
    border-radius: 3px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .form-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .form-link {
    font-weight: 700;
  }

  .form-meta {
    color: var(--text-faint);
    font-size: 0.78rem;
  }
</style>
