---
/**
 * The legislation scanner's controls, and what it has found.
 *
 * Two sets of settings with two different owners, deliberately kept apart:
 *
 *   The schedule — whether it runs, how often — belongs to whoever maintains
 *   the software. public.set_scan_schedule() refuses anyone but a Dev.
 *
 *   The review policy — whether a summary reaches the public without a person
 *   reading it — belongs to whoever answers for what the site says. That one
 *   needs news.publish, and it is off by default.
 *
 * The findings list is the queue that policy governs: entries arrive as drafts
 * and stay there until somebody publishes them.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { can } from '../../../lib/auth/session';
import { runScan } from '../../../lib/scan/run';
import { NOT_YET_IMPLEMENTED } from '../../../lib/scan/sources';

const { supabase, session } = Astro.locals;

if (!can(session, 'news.read')) {
  return Astro.redirect('/admin?error=forbidden', 303);
}

const isDev = (session.user?.level ?? 999) <= 1;
const mayPublish = can(session, 'news.publish');
const mayWrite = can(session, 'news.write');

let notice: { kind: 'success' | 'error'; message: string } | null = null;

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'schedule') {
    const { error } = await supabase.rpc('set_scan_schedule', {
      p_enabled: form.get('enabled') === 'on',
      p_runs_per_day: Number(form.get('runsPerDay') ?? 1),
      p_refresh_interval_hours: Number(form.get('refreshHours') ?? 24),
    });
    notice = error
      ? { kind: 'error', message: error.message }
      : { kind: 'success', message: 'Schedule saved.' };
  }

  if (action === 'review') {
    const { error } = await supabase.rpc('set_scan_review_policy', {
      p_auto_publish: form.get('autoPublish') === 'on',
      p_redraft_on_change: form.get('redraft') === 'on',
    });
    notice = error
      ? { kind: 'error', message: error.message }
      : { kind: 'success', message: 'Review policy saved.' };
  }

  if (action === 'run' && can(session, 'news.write')) {
    // Synchronous, and capped at 25 documents a run for that reason: a Worker
    // request has a CPU budget and a corpus does not care about it. Pressing
    // the button again continues where this one stopped, because an unchanged
    // hash costs nothing to skip.
    const result = await runScan(
      supabase,
      String(form.get('sourceKey') ?? ''),
      session.user?.id ?? null,
    );

    notice = result.error
      ? { kind: 'error', message: result.error }
      : {
          kind: 'success',
          message:
            `Saw ${result.documentsSeen}, ${result.documentsChanged} changed since last time. ` +
            `${result.entriesCreated} new, ${result.entriesUpdated} updated, ` +
            `${result.summariesGenerated} summarised.`,
        };
  }

  if (action === 'publish' && mayPublish) {
    const { error } = await supabase
      .from('legislation_entries')
      .update({
        status: 'published',
        approved_by: session.user?.id,
        approved_at: new Date().toISOString(),
        published_at: new Date().toISOString(),
      })
      .eq('id', String(form.get('entryId') ?? ''));
    notice = error
      ? { kind: 'error', message: error.message }
      : { kind: 'success', message: 'Published.' };
  }
}

type Settings = {
  enabled: boolean;
  runs_per_day: number;
  refresh_interval_hours: number;
  auto_publish: boolean;
  redraft_on_change: boolean;
};

type Source = {
  key: string;
  label: string;
  requires_key: boolean;
  enabled: boolean;
  last_run_at: string | null;
};
type Run = {
  id: string;
  source_key: string | null;
  status: string;
  started_at: string;
  finished_at: string | null;
  documents_seen: number;
  entries_created: number;
  entries_updated: number;
  error: string | null;
};
type Entry = {
  id: string;
  citation: string;
  title: string;
  source_url: string;
  stage: string;
  court_status: string;
  status: string;
  plain_summary: string | null;
  effective_at: string | null;
};

let settings: Settings | null = null;
let sources: Source[] = [];
let runs: Run[] = [];
let drafts: Entry[] = [];

if (supabase) {
  const [s, src, r, d] = await Promise.all([
    supabase.from('scan_settings').select('*').eq('id', true).maybeSingle(),
    supabase
      .from('legislation_sources')
      .select('key, label, requires_key, enabled, last_run_at')
      .order('key'),
    supabase.from('scan_runs').select('*').order('started_at', { ascending: false }).limit(10),
    supabase
      .from('legislation_entries')
      .select(
        'id, citation, title, source_url, stage, court_status, status, plain_summary, effective_at',
      )
      .eq('status', 'draft')
      .order('first_seen_at', { ascending: false })
      .limit(50),
  ]);

  settings = (s.data ?? null) as unknown as Settings | null;
  sources = (src.data ?? []) as unknown as Source[];
  runs = (r.data ?? []) as unknown as Run[];
  drafts = (d.data ?? []) as unknown as Entry[];
}
---

<AdminLayout title="Legislation scanner">
  <div class="admin-head">
    <h1>Legislation scanner</h1>
    <p>Federal and state firearms law, collected automatically and filed for review.</p>
  </div>

  {notice && <div class:list={['notice', notice.kind]}>{notice.message}</div>}

  <div class="admin-card">
    <h2>Schedule</h2>
    {
      !isDev && (
        <p class="hint">The schedule is set by a Dev. You can see it here but not change it.</p>
      )
    }
    <form method="POST">
      <input type="hidden" name="action" value="schedule" />
      <div class="field">
        <label class="checkline">
          <input type="checkbox" name="enabled" checked={settings?.enabled} disabled={!isDev} />
          <span>Run the scanner on a schedule</span>
        </label>
      </div>
      <div class="scan-grid">
        <div class="field">
          <label for="runsPerDay">Runs per day</label>
          <input
            type="number"
            id="runsPerDay"
            name="runsPerDay"
            min="1"
            max="24"
            value={settings?.runs_per_day ?? 1}
            disabled={!isDev}
          />
          <p class="hint">Spread evenly across the day.</p>
        </div>
        <div class="field">
          <label for="refreshHours">Refresh published entries (hours)</label>
          <input
            type="number"
            id="refreshHours"
            name="refreshHours"
            min="1"
            max="720"
            value={settings?.refresh_interval_hours ?? 24}
            disabled={!isDev}
          />
        </div>
      </div>
      {
        isDev && (
          <div class="form-actions">
            <button type="submit" class="btn-admin">
              Save schedule
            </button>
          </div>
        )
      }
    </form>
  </div>

  <div class="admin-card">
    <h2>Review policy</h2>
    <p>
      A summary is a machine's paraphrase of a firearms statute. Publishing one without reading it
      means the academy's name is on advice nobody checked.
    </p>
    <form method="POST">
      <input type="hidden" name="action" value="review" />
      <div class="field">
        <label class="checkline">
          <input
            type="checkbox"
            name="autoPublish"
            checked={settings?.auto_publish}
            disabled={!mayPublish}
          />
          <span>Publish findings automatically, without review</span>
        </label>
      </div>
      <div class="field">
        <label class="checkline">
          <input
            type="checkbox"
            name="redraft"
            checked={settings?.redraft_on_change}
            disabled={!mayPublish}
          />
          <span>Send an entry back to draft when the law behind it changes</span>
        </label>
        <p class="hint">
          Otherwise an amended statute keeps serving the text that was approved before the
          amendment.
        </p>
      </div>
      {
        mayPublish && (
          <div class="form-actions">
            <button type="submit" class="btn-admin">
              Save policy
            </button>
          </div>
        )
      }
    </form>
  </div>

  <div class="admin-card">
    <h2>Sources</h2>
    <table class="scan-table">
      <thead>
        <tr><th>Source</th><th>Key needed</th><th>Last run</th><th></th></tr>
      </thead>
      <tbody>
        {
          sources.map((s) => (
            <tr>
              <td>
                {s.label}
                {NOT_YET_IMPLEMENTED.includes(s.key) && (
                  <span class="src-todo">no adapter yet</span>
                )}
              </td>
              <td>{s.requires_key ? 'Yes' : 'No'}</td>
              <td>{s.last_run_at ? new Date(s.last_run_at).toLocaleString() : 'Never'}</td>
              <td>
                {mayWrite && !NOT_YET_IMPLEMENTED.includes(s.key) && (
                  <form method="POST">
                    <input type="hidden" name="action" value="run" />
                    <input type="hidden" name="sourceKey" value={s.key} />
                    <button type="submit" class="btn-admin secondary small">
                      Run now
                    </button>
                  </form>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="hint">
      eCFR and the Federal Register need no key and can be run right now. OpenStates, Congress.gov
      and CourtListener each need a free one; source keys are not stored yet, so those report the
      gap rather than quietly finding nothing. A run takes at most 25 documents — press again to
      continue, since anything unchanged costs nothing to skip.
    </p>
  </div>

  <div class="admin-card">
    <h2>Recent runs</h2>
    {runs.length === 0 && <p class="hint">The scanner has not run yet.</p>}
    {
      runs.length > 0 && (
        <table class="scan-table">
          <thead>
            <tr>
              <>
                <th>Started</th>
                <th>Source</th>
                <th>Status</th>
                <th>Seen</th>
                <th>New</th>
                <th>Updated</th>
              </>
            </tr>
          </thead>
          <tbody>
            {runs.map((r) => (
              <tr>
                <td>{new Date(r.started_at).toLocaleString()}</td>
                <td>{r.source_key ?? '—'}</td>
                <td>{r.error ? <span class="run-failed">{r.status}</span> : r.status}</td>
                <td>{r.documents_seen}</td>
                <td>{r.entries_created}</td>
                <td>{r.entries_updated}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>

  <div class="admin-card">
    <h2>Waiting for review</h2>
    {drafts.length === 0 && <p class="hint">Nothing waiting.</p>}
    {
      drafts.map((entry) => (
        <div class="draft-row">
          <div>
            <strong>{entry.citation}</strong> — {entry.title}
            <div class="invite-meta">
              {entry.stage}
              {entry.court_status !== 'none' && <> · {entry.court_status}</>}
              {entry.effective_at && <> · effective {entry.effective_at}</>}
            </div>
            {entry.plain_summary && <p class="draft-summary">{entry.plain_summary}</p>}
            <a
              href={entry.source_url}
              target="_blank"
              rel="noopener noreferrer"
              class="draft-source"
            >
              Read the source →
            </a>
          </div>
          {mayPublish && (
            <form method="POST">
              <input type="hidden" name="action" value="publish" />
              <input type="hidden" name="entryId" value={entry.id} />
              <button type="submit" class="btn-admin small">
                Publish
              </button>
            </form>
          )}
        </div>
      ))
    }
  </div>
</AdminLayout>

<style>
  .scan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 18px;
  }

  .checkline {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .checkline input {
    width: 18px;
    height: 18px;
  }

  .scan-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .scan-table th {
    text-align: left;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 8px 10px;
    border-bottom: 1px solid var(--hairline);
  }

  .scan-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--hairline);
  }

  .src-todo {
    margin-left: 10px;
    font-family: var(--font-heading);
    font-size: 0.58rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .run-failed {
    color: var(--status-bad-text, #d06a63);
  }

  .draft-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .invite-meta {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 4px;
  }

  .draft-summary {
    margin: 8px 0;
    color: var(--text-main);
  }

  .draft-source {
    font-size: 0.8rem;
  }

  .btn-admin.small {
    padding: 6px 12px;
    font-size: 0.62rem;
  }
</style>
