---
/**
 * Sign in.
 *
 * A plain form POST rather than a client-side call, so signing in works before
 * any JavaScript loads and the session cookie is set by the server in the same
 * response as the redirect.
 */
import '../../styles/base.css';
import '../../styles/admin.css';

const { supabase, session } = Astro.locals;

/** Only ever redirect to somewhere inside this site's admin area. */
function safeNext(raw: string | null): string {
  if (!raw) return '/admin';
  // A leading `//` or a scheme would take the visitor off-site entirely; an
  // open redirect on a login form is a phishing primitive, not a nuisance.
  if (!raw.startsWith('/') || raw.startsWith('//')) return '/admin';
  return raw.startsWith('/admin') ? raw : '/admin';
}

const next = safeNext(Astro.url.searchParams.get('next'));

/**
 * Login CSRF guard — a double submit cookie.
 *
 * Every other admin form is already covered by the session cookie being
 * SameSite=Lax: a cross-site POST does not carry it, so such a request arrives
 * signed out and does nothing. Sign-in is the exception, because it needs no
 * existing session. Without this, a third-party page can POST the attacker's
 * own credentials here and silently land the visitor inside an account the
 * attacker controls — where everything the visitor then types is the
 * attacker's to read.
 *
 * The token is minted on GET, kept in a cookie and echoed in a hidden field.
 * Only a page on this origin can read that cookie back, so only a form this
 * site rendered can present a matching pair.
 */
const CSRF_COOKIE = 'dj_login_csrf';
const CSRF_SHAPE = /^[0-9a-f]{64}$/;

function mintCsrfToken(): string {
  const bytes = new Uint8Array(32);
  crypto.getRandomValues(bytes);
  return [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
}

/** Compared in constant time, so a near miss is not distinguishable by clock. */
function tokensMatch(a: string, b: string): boolean {
  if (a.length === 0 || a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i += 1) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

let error: string | null = null;
let email = '';

// Already signed in and allowed in? Go straight through.
if (Astro.request.method === 'GET' && session.user && session.permissions.has('admin.access')) {
  return Astro.redirect(next, 302);
}

const errorParam = Astro.url.searchParams.get('error');
if (errorParam === 'suspended') {
  error = 'That account has been suspended. Ask an administrator to restore it.';
} else if (errorParam === 'no-access') {
  error =
    'That account exists but has not been given access to the admin area. Ask an administrator to assign a role.';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!tokensMatch(Astro.cookies.get(CSRF_COOKIE)?.value ?? '', String(form.get('csrf') ?? ''))) {
    // Either a genuinely stale form or a cross-site submission. The two are
    // indistinguishable from here, so the wording suits both.
    error = 'That sign-in form has expired. Please try again.';
  } else if (!supabase) {
    error = 'Sign-in is unavailable: this deployment has no Supabase connection configured.';
  } else if (!email || !password) {
    error = 'Enter your email address and password.';
  } else {
    const { error: authError } = await supabase.auth.signInWithPassword({ email, password });

    if (authError) {
      // Deliberately vague: saying which half was wrong tells an attacker
      // whether an address is a real account here.
      error = 'That email address and password do not match an account.';
    } else {
      Astro.cookies.delete(CSRF_COOKIE, { path: '/admin' });
      return Astro.redirect(next, 303);
    }
  }
}

// Reuse an existing token rather than rotating on every render: rotating would
// invalidate the form in any other tab the visitor already has open, and the
// value is unguessable either way.
const existingCsrf = Astro.cookies.get(CSRF_COOKIE)?.value;
const csrfToken = existingCsrf && CSRF_SHAPE.test(existingCsrf) ? existingCsrf : mintCsrfToken();

Astro.cookies.set(CSRF_COOKIE, csrfToken, {
  path: '/admin',
  httpOnly: true,
  sameSite: 'lax',
  secure: Astro.url.protocol === 'https:',
  maxAge: 60 * 60,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in | Academy admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/css/fonts.css" />
  </head>

  <body>
    <div class="login-shell">
      <div class="login-card">
        <img
          src="/img/logo.webp"
          alt="Devin Jordan Security Training Academy"
          width="230"
          height="230"
        />
        <h1>Academy Admin</h1>
        <p class="sub">Sign in to manage the website.</p>

        {error && <div class="notice error">{error}</div>}

        <form method="POST">
          <input type="hidden" name="csrf" value={csrfToken} />
          <div class="field">
            <label for="email">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              value={email}
              autocomplete="username"
              required
              autofocus
            />
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" class="btn-admin">Sign in</button>
        </form>

        <p class="login-foot"><a href="/">← Back to the website</a></p>
      </div>
    </div>
  </body>
</html>
