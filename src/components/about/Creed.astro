---
import { renderCopy } from '../../lib/format';

interface Props {
  /** Wrap phrases in {{braces}} to pick them out in gold. */
  text: string;
}

const { text } = Astro.props;
---

<div class="creed anim-enter-up">
  <p set:html={renderCopy(text)} />
</div>

<style>
  .creed {
    text-align: center;
    max-width: 820px;
    margin: 70px auto 0 auto;
    padding-top: 45px;
    border-top: 1px solid var(--hairline);
  }

  .creed p {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.5;
    color: var(--text-main);
  }

  @media (max-width: 900px) {
    .creed p {
      font-size: 1.05rem;
    }
  }
</style>
