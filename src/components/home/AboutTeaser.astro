---
import { paragraphs, renderCopy } from '../../lib/format';

interface Props {
  heading: string;
  subheading: string;
  body: string;
  ctaLabel: string;
  ctaHref?: string;
}

const { heading, subheading, body, ctaLabel, ctaHref = '/about' } = Astro.props;
---

<section class="about-section">
  <div class="about-grid">
    <div class="about-text anim-hard-left">
      <h2 set:html={renderCopy(heading)} />
      <h3>{subheading}</h3>
      {paragraphs(body).map((paragraph) => <p>{paragraph}</p>)}
      <a href={ctaHref} class="btn btn-ghost">{ctaLabel}</a>
    </div>
    <div class="about-image anim-hard-right">
      <img
        src="/img/crest-shield.svg"
        alt="Devin Jordan Security Training Academy crest"
        width="800"
        height="672"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 100px 20px;
    max-width: var(--wrap);
    margin: 0 auto;
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .about-text h2 {
    font-size: 3rem;
    color: var(--primary);
    margin-bottom: 10px;
    line-height: 1.1;
  }

  .about-text h3 {
    font-size: 1.2rem;
    color: var(--accent);
    margin-bottom: 25px;
    letter-spacing: 2px;
  }

  .about-text p {
    color: var(--text-muted);
    margin-bottom: 20px;
    font-size: 1.05rem;
  }

  .about-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 2px solid var(--border-card);
    box-shadow: var(--shadow-image);
    background: var(--bg-deep);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-text h2 {
      font-size: 2.2rem;
    }
  }
</style>
