---
/**
 * News & legislation board.
 *
 * CHANGED FROM THE ORIGINAL, deliberately: every entry is now rendered on the
 * server and the picker just filters what is already in the page. Before, the
 * board was built in the browser from a JavaScript object, which meant search
 * engines saw an empty div and a visitor with a blocked script saw nothing at
 * all. For a page whose whole purpose is telling officers what the law
 * currently says, "invisible unless JavaScript runs" was the wrong trade.
 *
 * The visible behaviour is unchanged.
 */
import type { Jurisdiction, NewsItem } from '../../lib/content/types';
import { safeUrl, statusBadgeClass } from '../../lib/format';

interface Props {
  jurisdictions: Jurisdiction[];
  items: NewsItem[];
  /** False until at least one entry is published; shows the connecting state. */
  feedReady: boolean;
  updatedAt: Date | null;
}

const { jurisdictions, items, feedReady, updatedAt } = Astro.props;

const quickPicks = jurisdictions.filter((j) => j.isQuickPick);
const defaultJurisdiction = quickPicks[0]?.code ?? jurisdictions[0]?.code ?? '';

function countFor(code: string): number {
  return items.filter((item) => item.jurisdictionCode === code).length;
}

const updatedLabel =
  feedReady && updatedAt
    ? `Last updated ${updatedAt.toLocaleString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        timeZone: 'America/New_York',
      })} ET`
    : 'Automatic updates coming soon';
---

<div
  class="news-wrap"
  data-feed-ready={String(feedReady)}
  data-default-jurisdiction={defaultJurisdiction}
>
  <p class="news-updated" id="newsUpdated">
    {
      feedReady ? (
        <>
          Last updated <span>{updatedLabel.replace('Last updated ', '')}</span>
        </>
      ) : (
        <span>{updatedLabel}</span>
      )
    }
  </p>

  <div class="news-level-label">Select jurisdiction</div>
  <div class="state-picker">
    <div class="state-pills" id="statePills">
      {
        quickPicks.map((jurisdiction) => (
          <button
            type="button"
            class:list={['state-pill', { active: jurisdiction.code === defaultJurisdiction }]}
            data-state={jurisdiction.code}
          >
            {jurisdiction.name}
            {feedReady && <span class="pill-count">{countFor(jurisdiction.code)}</span>}
          </button>
        ))
      }
    </div>

    <select id="stateSelect" class="state-select" aria-label="Choose a state or jurisdiction">
      {
        jurisdictions.map((jurisdiction) => (
          <option value={jurisdiction.code} selected={jurisdiction.code === defaultJurisdiction}>
            {jurisdiction.name}
            {feedReady ? ` (${countFor(jurisdiction.code)})` : ''}
          </option>
        ))
      }
    </select>
  </div>

  <div class="news-tabs" id="newsTabs" role="tablist">
    <button
      type="button"
      class="news-tab active"
      data-cat="legislation"
      role="tab"
      aria-selected="true"
    >
      Laws &amp; Bills
    </button>
    <button type="button" class="news-tab" data-cat="cases" role="tab" aria-selected="false">
      Court Cases
    </button>
  </div>

  <div id="newsList">
    {
      feedReady ? (
        items.map((item) => (
          <article
            class="news-item"
            data-jurisdiction={item.jurisdictionCode}
            data-category={item.category}
          >
            <div class="news-item-head">
              <h3>{item.title}</h3>
              {item.statusLabel && (
                <span class:list={['status-badge', statusBadgeClass(item.statusLabel)]}>
                  {item.statusLabel}
                </span>
              )}
            </div>

            {item.dateLabel && <div class="news-date">{item.dateLabel}</div>}
            <p class="news-summary">{item.summary}</p>

            {item.sources.length > 0 && (
              <div class="news-sources">
                <span class="src-label">Sources</span>
                {item.sources.map((source) => (
                  <a href={safeUrl(source.url)} target="_blank" rel="noopener noreferrer">
                    {source.label}
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      ) : (
        <div class="news-loading">
          <div class="news-loader">
            <div class="news-spinner" />
            <img class="news-loader-logo" src="/img/logo.webp" alt="" width="66" height="39" />
          </div>
          <p class="news-loading-label">
            Connecting <span id="loadingJurisdiction">jurisdiction</span> updates
            <span class="news-dots" />
          </p>
          <p class="news-loading-sub">
            Automatic tracking of <span id="loadingWhat">bills and laws</span> for this jurisdiction
            is still being set up. Check back soon, or call the academy with questions about current
            requirements.
          </p>
        </div>
      )
    }

    {
      /* Shown by the filter when a jurisdiction and category combination has no
        entries. Rendered once rather than built in JavaScript so the wording
        lives with the rest of the markup. */
    }
    <div class="news-empty" id="newsEmpty" hidden>
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      <p>
        No <span id="emptyWhat">bills or laws</span> currently tracked for
        <span id="emptyWhere">this state</span>. Check back after the next daily update.
      </p>
    </div>
  </div>
</div>

<style>
  .news-wrap {
    max-width: var(--wrap-narrow);
    margin: 0 auto;
    padding: 70px 20px 90px 20px;
  }

  .news-updated {
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 40px;
  }

  .news-updated :global(span) {
    color: var(--accent);
  }

  .news-level-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 14px;
  }

  .state-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
  }

  .state-select {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 1px;
    padding: 12px 16px;
    border-radius: 3px;
    cursor: pointer;
    min-width: 220px;
    transition: border-color 0.3s;
  }

  .state-select:hover,
  .state-select:focus {
    border-color: var(--accent);
    outline: none;
  }

  .state-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .state-pill {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: 3px;
    cursor: pointer;
    transition:
      border-color 0.3s,
      color 0.3s,
      background 0.3s;
  }

  .state-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .state-pill.active {
    background: var(--primary);
    border-color: var(--primary-edge);
    color: var(--text-bright);
  }

  .pill-count {
    display: inline-block;
    margin-left: 8px;
    opacity: 0.7;
    font-size: 0.75rem;
  }

  .news-tabs {
    display: flex;
    gap: 30px;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 34px;
  }

  .news-tab {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 2px 14px 2px;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .news-tab:hover {
    color: var(--accent);
  }

  .news-tab.active {
    color: var(--accent);
    border-bottom-color: var(--primary);
  }

  .news-item {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-left: 3px solid var(--primary);
    border-radius: var(--radius);
    padding: 28px 30px;
    margin-bottom: 20px;
    transition: border-color 0.3s;
  }

  .news-item:hover {
    border-color: var(--accent);
    border-left-color: var(--accent);
  }

  .news-item-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .news-item h3 {
    font-size: 1.15rem;
    color: var(--text-bright);
    line-height: 1.35;
    letter-spacing: 0.5px;
    flex: 1;
    min-width: 240px;
  }

  .status-badge {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
  }

  .status-badge.enacted {
    color: var(--status-ok-text);
    border-color: var(--status-ok-border);
    background: var(--status-ok-bg);
  }

  .status-badge.pending {
    color: var(--status-warn-text);
    border-color: var(--status-warn-border);
    background: var(--status-warn-bg);
  }

  .status-badge.decided {
    color: var(--status-info-text);
    border-color: var(--status-info-border);
    background: var(--status-info-bg);
  }

  .status-badge.closed {
    color: var(--status-err-text);
    border-color: var(--status-err-border);
    background: var(--status-err-bg);
  }

  .news-date {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .news-summary {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin-bottom: 18px;
  }

  .news-sources {
    border-top: 1px solid var(--hairline);
    padding-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
  }

  .src-label {
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary);
  }

  .news-sources a {
    color: var(--accent);
    font-size: 0.88rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(197, 160, 89, 0.35);
    transition: border-color 0.3s;
  }

  .news-sources a:hover {
    border-bottom-color: var(--accent);
  }

  .news-sources a i {
    font-size: 0.7em;
    margin-left: 0.3em;
  }

  .news-empty {
    text-align: center;
    padding: 60px 20px;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius);
    color: var(--text-muted);
  }

  .news-empty i {
    font-size: 1.8rem;
    color: var(--accent);
    margin-bottom: 16px;
    display: block;
  }

  /* --- "Still being connected" state -------------------------------------- */
  .news-loading {
    text-align: center;
    padding: 70px 20px;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius);
    color: var(--text-muted);
  }

  /* The mark stays still in the centre; the ring rotates around it. */
  .news-loader {
    position: relative;
    width: 104px;
    height: 104px;
    margin: 0 auto 26px auto;
  }

  .news-spinner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid var(--hairline);
    border-top-color: var(--accent);
    animation: news-spin 1.1s linear infinite;
  }

  .news-loader-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 66px;
    height: auto;
    border-radius: var(--radius);
    display: block;
    animation: news-logo-pulse 2.2s ease-in-out infinite;
  }

  @keyframes news-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes news-logo-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  .news-loading-label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .news-loading-label :global(span) {
    color: var(--accent);
  }

  .news-dots::after {
    content: '';
    animation: news-dots 1.4s steps(4, end) infinite;
  }

  @keyframes news-dots {
    0% {
      content: '';
    }
    25% {
      content: '.';
    }
    50% {
      content: '..';
    }
    75% {
      content: '...';
    }
    100% {
      content: '';
    }
  }

  .news-loading-sub {
    margin-top: 12px;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
    opacity: 0.85;
  }

  .news-loading-sub :global(span) {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .news-spinner,
    .news-loader-logo,
    .news-dots::after {
      animation: none;
    }

    .news-loader-logo {
      opacity: 1;
    }
  }
</style>
