# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# PUBLIC_* values are exposed to the browser by design. Everything else is
# server-only and must be set as a secret in production:
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------

# Canonical site URL, used for canonical tags, sitemap and auth redirects.
PUBLIC_SITE_URL="http://localhost:4321"

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
PUBLIC_SUPABASE_URL=""

# Publishable ("anon") key. Safe in the browser: every table is protected by
# row level security, so this key can only do what RLS policies allow.
PUBLIC_SUPABASE_ANON_KEY=""

# Service role key. BYPASSES row level security — server-side only, never
# import this into anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
